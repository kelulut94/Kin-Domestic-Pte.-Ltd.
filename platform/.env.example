# Copy to .env and fill in. Never commit .env.
APP_NAME=Helper Marketplace
PORT=3000
BASE_URL=http://localhost:3000
NODE_ENV=development

# Where the SQLite database and uploaded photos live (must be on a persistent disk in production)
# DB_FILE=./data/app.db
# UPLOAD_DIR=./data/uploads

# First admin account, created by `npm run seed`
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please

# Stripe (optional). Without these, admins grant subscriptions by hand.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=

# Prices shown on the pricing page (display only; Stripe charges what the price IDs say)
PLAN_MONTHLY_LABEL=S$99 / month
PLAN_YEARLY_LABEL=S$990 / year
